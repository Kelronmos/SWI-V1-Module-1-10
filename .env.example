# SWI Environment Configuration Template
# Copy this to .env and update values as needed
#
# NOTE: As of this version, none of the variables below are read by
# swi_core (no os.environ / getenv / dotenv calls in the package).
# This file is a placeholder for planned configuration wiring, not a
# working config surface yet. Constructor arguments (see INSTALLATION.md)
# are the only way to actually configure module behavior right now.

# Environment
SWI_ENV=development
SWI_DEBUG=false
SWI_LOG_LEVEL=INFO
SWI_CONFIG_PATH=config/swi_config.yaml

# Security Settings
SWI_ENCRYPTION_KEY_LENGTH=32
SWI_TOKEN_EXPIRY=3600
SWI_SECURITY_RISK_THRESHOLD=0.7

# Paths
SWI_LOG_DIR=logs
SWI_TEMP_DIR=.swi_temp
SWI_AUDIT_LOG=logs/audit.jsonl
SWI_CACHE_DIR=.swi_cache

# Testing
SWI_TEST_MODE=false
SWI_PYTEST_ARGS=-v --cov=swi_core --cov-report=term
SWI_COVERAGE_THRESHOLD=80

# Module Settings
SWI_MODULE_02_RISK_THRESHOLD=0.7
SWI_MODULE_03_MAX_AGE_SECONDS=3600
SWI_MODULE_06_SIMILARITY_THRESHOLD=0.8
SWI_MODULE_10_TIMEOUT_SECONDS=30
SWI_MODULE_10_MEMORY_LIMIT_MB=512
