{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SWIV1CoreModuleInput",
  "description": "Zero-base input contract for SWI Volume 1 Modules 00-10. parameters is closed (additionalProperties false).",
  "type": "object",
  "properties": {
    "module_id": {
      "type": "string",
      "pattern": "^M(0[0-9]|10)$"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "payload_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "data": {
      "type": "object",
      "properties": {
        "execution_mode": {
          "type": "string",
          "enum": ["DETERMINISTIC", "AUDIT_ONLY", "DRY_RUN"]
        },
        "strict_validation": { "type": "boolean" },
        "parameters": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "required": ["execution_mode", "strict_validation"],
      "additionalProperties": false
    }
  },
  "required": ["module_id", "timestamp_utc", "payload_version", "data"],
  "additionalProperties": false
}
