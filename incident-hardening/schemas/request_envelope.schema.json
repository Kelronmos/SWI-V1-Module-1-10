{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "swi://schemas/request_envelope.v1",
  "title": "SWI Consequential Request Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id", "principal", "operation", "resource", "target",
    "environment", "scope", "network_policy", "policy_version",
    "environment_hash", "scope_hash", "timestamp", "decision"
  ],
  "properties": {
    "request_id": { "type": "string", "minLength": 1 },
    "principal": { "type": "string", "minLength": 1 },
    "module": { "type": ["string", "null"] },
    "role": { "type": ["string", "null"] },
    "operation": { "type": "string", "minLength": 1 },
    "resource": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "credential_reference": { "type": ["string", "null"] },
    "network_policy": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "policy_version": { "type": "string", "minLength": 1 },
    "environment_hash": { "type": "string", "minLength": 1 },
    "scope_hash": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "decision": {
      "type": "string",
      "enum": ["UNKNOWN", "DENIED", "APPROVED", "BLOCKED", "HALTED", "EXECUTED"]
    }
  }
}
